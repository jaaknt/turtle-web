# Copy to api/.env for local development against the demo database (docker-compose.yml).
# These values are the demo database's, not secrets. Production reads the same variables from
# ~/.config/turtle-web/secrets.env on the VPS, with the read-only turtle_web role.
TURTLE_WEB_DB_HOST=localhost
TURTLE_WEB_DB_PORT=5433
TURTLE_WEB_DB_USER=postgres
TURTLE_WEB_DB_PASSWORD=demo
TURTLE_WEB_BENCHMARK_SYMBOL=BENCH.US
