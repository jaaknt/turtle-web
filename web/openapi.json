{"openapi": "3.1.0", "info": {"title": "turtle-web", "version": "0.1.0"}, "paths": {"/api/healthz": {"get": {"summary": "Healthz", "description": "Report that the process is up, without querying the database.\n\nPostgres on the VPS can refuse connections after a reboot; a health check that queried would\nturn that into a restart loop instead of a single failed request.", "operationId": "healthz_api_healthz_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Healthz Api Healthz Get"}}}}}}}, "/api/portfolio": {"get": {"summary": "Portfolio", "description": "Open positions, totals and daily P&L history against each shadow benchmark.\n\nArgs:\n    request: The incoming request, carrying the engine and settings.", "operationId": "portfolio_api_portfolio_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Portfolio"}}}}}}}, "/api/analytics": {"get": {"summary": "Portfolio Analytics", "description": "Time-weighted returns of the portfolio and each benchmark: metrics, curves, drawdowns, histograms.\n\nThe same two queries as /portfolio; analytics.report builds it, see docs/specs/portfolio.md.\n\nArgs:\n    request: The incoming request, carrying the engine and settings.", "operationId": "portfolio_analytics_api_analytics_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Analytics"}}}}}}}, "/api/transactions": {"get": {"summary": "Transactions", "description": "Every fill, oldest first, with its signal and the slippage against the signal's next open.\n\nArgs:\n    request: The incoming request, carrying the engine.", "operationId": "transactions_api_transactions_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/Transaction"}, "type": "array", "title": "Response Transactions Api Transactions Get"}}}}}}}, "/api/symbols": {"get": {"summary": "Symbols", "description": "Every symbol with bars, for the chart page's search.\n\nArgs:\n    request: The incoming request, carrying the engine and the symbol cache.\n    response: Used to set Cache-Control.", "operationId": "symbols_api_symbols_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/Symbol"}, "type": "array", "title": "Response Symbols Api Symbols Get"}}}}}}}, "/api/chart/{symbol}": {"get": {"summary": "Chart", "description": "One symbol's daily candles, its fills, and the open position's average cost.\n\nNot cached: its fills and avg_cost change as soon as a statement is imported.\n\nArgs:\n    request: The incoming request, carrying the engine and settings.\n    symbol: Ticker code, such as AAPL.US.\n    start: First bar date; defaults to three years back.\n    adjusted: Scale O/H/L/C by adjusted_close / close per bar, and volume by its inverse, so a\n        split shows in neither. The fills and the average-cost line stay raw, so avg_cost is\n        None on adjusted candles.", "operationId": "chart_api_chart__symbol__get", "parameters": [{"name": "symbol", "in": "path", "required": true, "schema": {"type": "string", "title": "Symbol"}}, {"name": "start", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Start"}}, {"name": "adjusted", "in": "query", "required": false, "schema": {"type": "boolean", "default": false, "title": "Adjusted"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChartData"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/signals": {"get": {"summary": "Signals", "description": "Signals of the configured strategy from the last `days` days, gated at `min_ranking`.\n\nValidated at the edge, so a bad URL is a 422 and never a slow query.\n\nArgs:\n    request: The incoming request, carrying the engine and settings.\n    days: How far back to look, in calendar days.\n    min_ranking: The gate; kept when ranking >= min_ranking, so a signal scoring exactly the\n        gate is included.", "operationId": "signals_api_signals_get", "parameters": [{"name": "days", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 366, "minimum": 1, "default": 90, "title": "Days"}}, {"name": "min_ranking", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 100, "minimum": 0, "default": 44, "title": "Min Ranking"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/SignalRow"}, "title": "Response Signals Api Signals Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"Analytics": {"properties": {"start": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Start"}, "end": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "End"}, "trading_days": {"type": "integer", "title": "Trading Days"}, "benchmarks": {"items": {"type": "string"}, "type": "array", "title": "Benchmarks"}, "series": {"items": {"$ref": "#/components/schemas/SeriesAnalytics"}, "type": "array", "title": "Series"}, "curve": {"items": {"$ref": "#/components/schemas/CurvePoint"}, "type": "array", "title": "Curve"}, "drawdowns": {"items": {"$ref": "#/components/schemas/DrawdownPeriod"}, "type": "array", "title": "Drawdowns"}, "histogram_monthly": {"items": {"$ref": "#/components/schemas/Bin"}, "type": "array", "title": "Histogram Monthly"}, "histogram_daily": {"items": {"$ref": "#/components/schemas/Bin"}, "type": "array", "title": "Histogram Daily"}}, "type": "object", "required": ["start", "end", "trading_days", "benchmarks", "series", "curve", "drawdowns", "histogram_monthly", "histogram_daily"], "title": "Analytics", "description": "The analytics page: time-weighted returns of the portfolio against each benchmark held; see analytics.Report."}, "Bar": {"properties": {"time": {"type": "string", "title": "Time"}, "open": {"type": "number", "title": "Open"}, "high": {"type": "number", "title": "High"}, "low": {"type": "number", "title": "Low"}, "close": {"type": "number", "title": "Close"}, "volume": {"type": "number", "title": "Volume"}}, "type": "object", "required": ["time", "open", "high", "low", "close", "volume"], "title": "Bar", "description": "One candle."}, "Bin": {"properties": {"lower": {"type": "number", "title": "Lower"}, "upper": {"type": "number", "title": "Upper"}, "count": {"type": "integer", "title": "Count"}}, "type": "object", "required": ["lower", "upper", "count"], "title": "Bin", "description": "One histogram bar: count of values in [lower, upper)."}, "ChartData": {"properties": {"symbol": {"type": "string", "title": "Symbol"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Name"}, "adjusted": {"type": "boolean", "title": "Adjusted"}, "bars": {"items": {"$ref": "#/components/schemas/Bar"}, "type": "array", "title": "Bars"}, "fills": {"items": {"$ref": "#/components/schemas/ChartFill"}, "type": "array", "title": "Fills"}, "avg_cost": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Avg Cost"}}, "type": "object", "required": ["symbol", "name", "adjusted", "bars", "fills", "avg_cost"], "title": "ChartData", "description": "One symbol's candles and fills."}, "ChartFill": {"properties": {"time": {"type": "string", "title": "Time"}, "side": {"type": "string", "enum": ["buy", "sell"], "title": "Side"}, "quantity": {"type": "number", "title": "Quantity"}, "price": {"type": "number", "title": "Price"}}, "type": "object", "required": ["time", "side", "quantity", "price"], "title": "ChartFill", "description": "One fill, drawn as a marker by time only."}, "CurvePoint": {"properties": {"date": {"type": "string", "format": "date", "title": "Date"}, "cumulative": {"additionalProperties": {"type": "number"}, "type": "object", "title": "Cumulative"}, "drawdown": {"additionalProperties": {"type": "number"}, "type": "object", "title": "Drawdown"}}, "type": "object", "required": ["date", "cumulative", "drawdown"], "title": "CurvePoint", "description": "Every series' cumulative return and drawdown at the end of one day."}, "DrawdownPeriod": {"properties": {"start": {"type": "string", "format": "date", "title": "Start"}, "valley": {"type": "string", "format": "date", "title": "Valley"}, "end": {"type": "string", "format": "date", "title": "End"}, "depth": {"type": "number", "title": "Depth"}, "days": {"type": "integer", "title": "Days"}, "ongoing": {"type": "boolean", "title": "Ongoing"}}, "type": "object", "required": ["start", "valley", "end", "depth", "days", "ongoing"], "title": "DrawdownPeriod", "description": "One stretch under water."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "HistoryPoint": {"properties": {"date": {"type": "string", "format": "date", "title": "Date"}, "market_value": {"type": "number", "title": "Market Value"}, "cost_basis": {"type": "number", "title": "Cost Basis"}, "realized": {"type": "number", "title": "Realized"}, "total_pnl": {"type": "number", "title": "Total Pnl"}, "benchmark_pnl": {"additionalProperties": {"type": "number"}, "type": "object", "title": "Benchmark Pnl"}}, "type": "object", "required": ["date", "market_value", "cost_basis", "realized", "total_pnl", "benchmark_pnl"], "title": "HistoryPoint", "description": "Portfolio totals at the end of one day."}, "Metrics": {"properties": {"cumulative_return": {"type": "number", "title": "Cumulative Return"}, "cagr": {"type": "number", "title": "Cagr"}, "volatility": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Volatility"}, "sharpe": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Sharpe"}, "sortino": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Sortino"}, "calmar": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Calmar"}, "max_drawdown": {"type": "number", "title": "Max Drawdown"}, "longest_drawdown_days": {"type": "integer", "title": "Longest Drawdown Days"}, "best_day": {"type": "number", "title": "Best Day"}, "worst_day": {"type": "number", "title": "Worst Day"}, "best_month": {"type": "number", "title": "Best Month"}, "worst_month": {"type": "number", "title": "Worst Month"}, "win_rate_days": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Win Rate Days"}, "win_rate_months": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Win Rate Months"}, "beta": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Beta"}, "correlation": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Correlation"}}, "type": "object", "required": ["cumulative_return", "cagr", "volatility", "sharpe", "sortino", "calmar", "max_drawdown", "longest_drawdown_days", "best_day", "worst_day", "best_month", "worst_month", "win_rate_days", "win_rate_months", "beta", "correlation"], "title": "Metrics", "description": "The metrics table's column for one series; see analytics.Metrics. A ratio over a zero denominator is None."}, "PeriodReturn": {"properties": {"year": {"type": "integer", "title": "Year"}, "month": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Month"}, "value": {"type": "number", "title": "Value"}, "partial": {"type": "boolean", "title": "Partial"}}, "type": "object", "required": ["year", "month", "value", "partial"], "title": "PeriodReturn", "description": "A month's or a year's compounded return."}, "Portfolio": {"properties": {"benchmarks": {"items": {"type": "string"}, "type": "array", "title": "Benchmarks"}, "totals": {"anyOf": [{"$ref": "#/components/schemas/HistoryPoint"}, {"type": "null"}]}, "positions": {"items": {"$ref": "#/components/schemas/Position"}, "type": "array", "title": "Positions"}, "history": {"items": {"$ref": "#/components/schemas/HistoryPoint"}, "type": "array", "title": "History"}}, "type": "object", "required": ["benchmarks", "totals", "positions", "history"], "title": "Portfolio", "description": "Totals, open positions and daily history; totals.realized includes fully closed positions."}, "Position": {"properties": {"symbol": {"type": "string", "title": "Symbol"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Name"}, "sector": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Sector"}, "shares": {"type": "number", "title": "Shares"}, "avg_cost": {"type": "number", "title": "Avg Cost"}, "last_close": {"type": "number", "title": "Last Close"}, "last_date": {"type": "string", "format": "date", "title": "Last Date"}, "day_change_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Day Change Pct"}, "market_value": {"type": "number", "title": "Market Value"}, "cost_basis": {"type": "number", "title": "Cost Basis"}, "unrealized": {"type": "number", "title": "Unrealized"}, "unrealized_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Unrealized Pct"}, "realized": {"type": "number", "title": "Realized"}, "first_buy": {"type": "string", "format": "date", "title": "First Buy"}, "days_held": {"type": "integer", "title": "Days Held"}}, "type": "object", "required": ["symbol", "name", "sector", "shares", "avg_cost", "last_close", "last_date", "day_change_pct", "market_value", "cost_basis", "unrealized", "unrealized_pct", "realized", "first_buy", "days_held"], "title": "Position", "description": "One open position, valued at its latest close."}, "SeriesAnalytics": {"properties": {"symbol": {"type": "string", "title": "Symbol"}, "metrics": {"$ref": "#/components/schemas/Metrics"}, "monthly": {"items": {"$ref": "#/components/schemas/PeriodReturn"}, "type": "array", "title": "Monthly"}, "yearly": {"items": {"$ref": "#/components/schemas/PeriodReturn"}, "type": "array", "title": "Yearly"}}, "type": "object", "required": ["symbol", "metrics", "monthly", "yearly"], "title": "SeriesAnalytics", "description": "One series' metrics and period returns."}, "SignalRow": {"properties": {"id": {"type": "integer", "title": "Id"}, "symbol": {"type": "string", "title": "Symbol"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Name"}, "signal_date": {"type": "string", "format": "date", "title": "Signal Date"}, "ranking": {"type": "integer", "title": "Ranking"}, "next_open": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Next Open"}, "pct_vs_sma50": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Pct Vs Sma50"}, "adr_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Adr Pct"}, "entry_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Entry Date"}, "entry_price": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Entry Price"}, "curr_price": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Curr Price"}, "curr_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Curr Date"}, "change_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Change Pct"}, "bought": {"type": "boolean", "title": "Bought"}}, "type": "object", "required": ["id", "symbol", "name", "signal_date", "ranking", "next_open", "pct_vs_sma50", "adr_pct", "entry_date", "entry_price", "curr_price", "curr_date", "change_pct", "bought"], "title": "SignalRow", "description": "One gated signal, with its entry and current price."}, "Symbol": {"properties": {"symbol": {"